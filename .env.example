# Copy to .env.local for local development, and add the real values as
# environment variables in the Vercel project settings for production.

# GA4 measurement ID (Admin > Data streams > your stream), e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Resend API key used by api/contact.js to send contact form submissions.
# Create one at https://resend.com after verifying a sending domain.
RESEND_API_KEY=
